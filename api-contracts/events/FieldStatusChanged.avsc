{
  "type": "record",
  "name": "FieldStatusChanged",
  "namespace": "com.rpms.events.plantation",
  "doc": "Emitted when a field's operational status changes (e.g. ACTIVE -> FALLOW -> DECOMMISSIONED) in Module 1. Partition key: fieldId. Consumed by: tapping-service (M3), activity-service (M5).",
  "fields": [
    { "name": "metadata", "type": "com.rpms.events.EventMetadata" },
    { "name": "fieldId", "type": "int" },
    { "name": "plantationId", "type": "int" },
    { "name": "fieldCode", "type": "string" },
    { "name": "fieldCategory", "type": "string", "doc": "Natural key code from lu_field_category, e.g. MATURE" },
    { "name": "oldStatus", "type": ["null", "string"], "default": null },
    { "name": "newStatus", "type": "string" },
    { "name": "effectiveDate", "type": { "type": "int", "logicalType": "date" } }
  ]
}
